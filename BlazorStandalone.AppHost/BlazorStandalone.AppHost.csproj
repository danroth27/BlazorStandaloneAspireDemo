<Project Sdk="Aspire.AppHost.Sdk/13.6.0-preview.1.26463.6">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <!-- The standalone Blazor APIs are experimental. -->
    <NoWarn>$(NoWarn);ASPIREBLAZOR001</NoWarn>
    <UserSecretsId>e0ef506e-f5c3-4687-9e01-056c93fcbda2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Blazor + Aspire integration currently ships only as a preview package. -->
    <PackageReference Include="Aspire.Hosting.Blazor" Version="13.6.0-preview.1.26463.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorStandalone.ApiService\BlazorStandalone.ApiService.csproj" />
    <ProjectReference Include="..\BlazorStandalone\BlazorStandalone.csproj" />
  </ItemGroup>

</Project>
