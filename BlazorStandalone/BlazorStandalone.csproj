<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
    <!-- WASM runtime diagnostics feature switches. These default to OFF (trimmed) in Blazor
         WebAssembly, so without them System.Diagnostics.Metrics instruments are no-ops and
         HttpClient never creates Activity spans, leaving the client with no metrics/traces.

         .NET 11 Preview 6 added a BlazorWasmDiagnosticsEnabled property intended to turn all
         three on by default, but it does not work in Preview 6 (verified by inspecting the
         generated runtimeconfig.json):
           1. Microsoft.NET.Sdk.BlazorWebAssembly.Current.props defaults
              'BlazorWebAssemblyDiagnosticsEnabled' but the three conditions gate on
              'BlazorWasmDiagnosticsEnabled' - the names don't match, so the default never fires.
              Fixed on dotnet/sdk main by PR #55447 (2026-07-24), after Preview 6 was cut.
           2. Those conditions are evaluated in Sdk.props, which is imported before this project
              body, so setting either name here has no effect. Only -p: or Directory.Build.props
              would reach it. Still unfixed - tracked by dotnet/sdk#55489.
         Setting the individual switches explicitly works in all cases, so do that until a preview
         with the fix ships. HttpActivityPropagationSupport already emits the
         System.Net.Http.EnableActivityPropagation runtime config option, so no separate
         RuntimeHostConfigurationOption entry is needed. -->
    <MetricsSupport>true</MetricsSupport>
    <EventSourceSupport>true</EventSourceSupport>
    <HttpActivityPropagationSupport>true</HttpActivityPropagationSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-preview.6.26359.118" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0-preview.6.26359.118" PrivateAssets="all" />
    <!-- Service discovery reads endpoints from IConfiguration; the gateway delivers them as env vars. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0-preview.6.26359.118" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorStandalone.ClientServiceDefaults\BlazorStandalone.ClientServiceDefaults.csproj" />
  </ItemGroup>

</Project>
